SELECT sname,age FROM sailors;

SELECT * FROM sailors
WHERE using > 7;

SELECT s.sname
FROM sailors s,reserves r
WHERE s.sid=r.sid
AND r.bid=103;

SELECT DISTINCT r.sid
FROM reserves r,boats b
WHERE r.bid=b.bid
AND b.color='red';

SELECT DISTINCT s.sname
FROM sailors s,reserves r,boats b
WHERE s.sid=r.sid
AND r.bid=b.bid
AND b.color='red';

SELECT DISTINCT b.color
FROM sailors s,reserves r,boats b
WHERE s.sid=r.sid
AND r.sid=b.bid
AND s.sname='lubber';
