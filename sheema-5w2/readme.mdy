--q1
CREATE TABLE DEPT
(
    DNO NUMBER PRIMARY KEY,
    DNAME VARCHAR2(30) NOT NULL
);
![output 1](O1)

--q2
CREATE TABLE STUDENT1
(
    SID NUMBER PRIMARY KEY,
    SNAME VARCHAR2(30) NOT NULL,
    DID NUMBER
    );
![OUTPUT 2](O2)

    
--Q3
ALTER TABLE STUDENT1
ADD CONSTRAINT FK_DID
FOREIGN KEY(DID)
REFERENCES DEPT(DNO);

