--Q7
SELECT SID, SNAME, DNO, DNAME
FROM STUDENT1 S
JOIN DEPT D
ON S.DID=D.DNO;

SELECT * FROM STUDENT1;
SELECT * FROM DEPT;
![OUTPUT 4](O4)


--Q8
SELECT S.SID,
       S.SNAME,
       D.DNO,
       D.DNAME
FROM STUDENT1 S
INNER JOIN DEPT D
ON S.DID = D.DNO;

--Q9
SELECT S.SID,
       S.SNAME,
       D.DNO,
       D.DNAME
FROM STUDENT1 S
JOIN DEPT D
ON S.DID > D.DNO;
![OUTPUT 5](O5)


--Q10
SELECT S.SID,
       S.SNAME,
       S.DID,
       D.DNAME
FROM STUDENT1 S
LEFT OUTER JOIN DEPT D
ON S.DID = D.DNO;


--Q11
SELECT S.SID,
       S.SNAME,
       D.DNO,
       D.DNAME
FROM STUDENT1 S
RIGHT OUTER JOIN DEPT D
ON S.DID = D.DNO;
![OUTPUT 6](O6)
